# Power management for a BLE companion.
#
# The CPU is allowed to drop into light sleep between BLE connection events,
# which is what makes an ESP32 companion cheap while it stays reachable: the
# controller keeps the link and wakes the CPU for a connection event, and the
# application only has to yield for the idle task to hand the CPU over.
#
# The prebuilt libraries that ship with platformio/espressif32@6.11.0 are
# compiled with CONFIG_PM_ENABLE unset, so esp_pm_configure() returns
# ESP_ERR_NOT_SUPPORTED there. These options therefore only exist in a build of
# the libraries made with this file; see agent_docs/power.md.
CONFIG_PM_ENABLE=y
CONFIG_FREERTOS_USE_TICKLESS_IDLE=y
CONFIG_FREERTOS_IDLE_TIME_BEFORE_SLEEP=3
CONFIG_PM_SLP_IRAM_OPT=y

# Bluetooth controller: sleep between connection events, and keep the main XTAL
# powered across a light sleep so the controller can still wake the CPU for a
# connection event. ESP32-S3 shares the C3 controller in IDF 4.4, hence the
# BT_CTRL_* names (the classic ESP32 uses BTDM_CTRL_* and cannot do this at all
# without an external 32.768 kHz crystal).
CONFIG_BT_CTRL_MODEM_SLEEP=y
CONFIG_BT_CTRL_MODEM_SLEEP_MODE_1=y
CONFIG_BT_CTRL_LPCLK_SEL_MAIN_XTAL=y
CONFIG_BT_CTRL_MAIN_XTAL_PU_DURING_LIGHT_SLEEP=y
