# Pinned inputs of the build. Everything that decides what ends up in the
# package is here; change a line, bump PS_REVISION.

# Our revision on top of the upstream core: 2.0.17-ps.<PS_REVISION>
PS_REVISION=1

# Upstream arduino-esp32 release the libraries belong to
ARDUINO_VERSION=2.0.17

# ESP-IDF the 2.0.17 libraries were built with (tools/sdk/versions.txt: v4.4.7 38eeba213a)
IDF_VERSION=v4.4.7
IDF_DOCKER_IMAGE=espressif/idf:v4.4.7

# espressif/esp32-arduino-lib-builder, branch release/v4.4
LIB_BUILDER_COMMIT=3eb9cb06afb534d37f47e98bca9f45e99126f81a

# Components, as recorded in the stock 2.0.17 tools/sdk/versions.txt
ARDUINO_COMPONENT_REF=2.0.17
TINYUSB_COMMIT=a0e5626bc
ESP32_CAMERA_COMMIT=f0bb429
ESP_DL_COMMIT=0632d24
ESP_LITTLEFS_COMMIT=41873c2
ESP_RAINMAKER_COMMIT=d8e9345
ESP_DSP_COMMIT=9b4a8b4

# Stock PlatformIO package the rebuilt libraries are laid over
STOCK_PKG_VERSION=3.20017.241212+sha.dcc1105b
STOCK_PKG_URL=https://dl.registry.platformio.org/download/platformio/tool/framework-arduinoespressif32/3.20017.241212+sha.dcc1105b/framework-arduinoespressif32-3.20017.241212+sha.dcc1105b.tar.gz
STOCK_PKG_SHA256=7dbcfb86f9dfd5ecf6c881ed8226239d9ef63f27e1e1a2ddd87a87762e2ffbc9

# Targets and memory variants. "base" = the idf_libs build (lib/*.a, include);
# variants = flash:freq:psram triplets handed to the mem_variant target.
TARGETS="esp32s3 esp32 esp32c3"
VARIANTS_esp32s3="qio:80m:qio_ram qio:80m:opi_ram dio:80m:qio_ram dio:80m:opi_ram opi:80m:opi_ram opi:80m:qio_ram"
VARIANTS_esp32="dio:80m:none dout:80m:none qio:80m:none qout:80m:none"
VARIANTS_esp32c3="dio:80m:none dout:80m:none qio:80m:none qout:80m:none"
